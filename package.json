{
  "name": "app-hockey-production",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "auth:secret": "node scripts/generate-auth-secret.mjs",
    "env:validate": "node scripts/validate-env.mjs",
    "env:sync-prisma": "node scripts/sync-prisma-env.mjs",
    "setup:next-steps": "node scripts/next-steps.mjs",
    "db:generate": "npm run env:sync-prisma && prisma generate",
    "db:migrate": "npm run env:sync-prisma && prisma migrate dev",
    "db:seed": "npm run env:sync-prisma && prisma db seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@aws-sdk/s3-request-presigner": "^3.1050.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "16.2.6",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
