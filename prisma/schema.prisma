generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  participant
  coach
  admin
}

enum DocumentAudience {
  participant
  coach
}

model User {
  id              String     @id @default(cuid())
  username        String     @unique
  email           String     @unique
  fullName        String
  passwordHash    String
  role            Role
  groupName       String?
  participantCode String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  participantDocs Document[] @relation("ParticipantDocuments")
  coachDocs       Document[] @relation("CoachAccess")

  @@index([role])
  @@index([groupName])
}

model DocumentCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]

  @@index([createdAt])
}

model Document {
  id            String   @id @default(cuid())
  title         String
  description   String?
  fileName      String
  storageKey    String
  updatedAt     DateTime @default(now())
  audience      DocumentAudience @default(participant)
  isVisibleToParticipant Boolean @default(true)
  categoryId    String?
  participantId String?
  coachId       String?

  category    DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  participant User? @relation("ParticipantDocuments", fields: [participantId], references: [id], onDelete: Cascade)
  coach       User? @relation("CoachAccess", fields: [coachId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([isVisibleToParticipant])
  @@index([participantId])
  @@index([audience])
  @@index([updatedAt])
}
